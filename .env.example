# Square
SQUARE_ACCESS_TOKEN=replace_me
SQUARE_WEBHOOK_SIGNATURE_KEY=replace_me
SQUARE_WEBHOOK_URL=https://YOUR-DOMAIN.example/square/webhook
SQUARE_API_VERSION=2026-08-19
SQUARE_BASE_URL=https://connect.squareup.com

# Only print orders from this Square location (recommended)
SQUARE_LOCATION_ID=

# Catalog Modifier List ID that represents MILK
MILK_MODIFIER_LIST_ID=

# Printer/layout
PRINT_WIDTH_DOTS=256
MIN_LABEL_HEIGHT_DOTS=195
NAME_MAX_FONT_PX=72
CODE_MAX_FONT_PX=64
MIN_CODE_FONT_PX=34
LINE_GAP_DOTS=0

# Use actual Arial font files on the SERVER if available.
# Examples on Windows:
# FONT_BLACK=C:\Windows\Fonts\ariblk.ttf
# FONT_BOLD=C:\Windows\Fonts\arialbd.ttf
FONT_BLACK=
FONT_BOLD=

# CloudPRNT
# Optional: only accept this printer MAC, e.g. 00:11:62:AA:BB:CC
STAR_PRINTER_MAC=
